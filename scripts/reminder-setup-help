#!/usr/bin/python3
"""Read-only EDS calendar discovery with copy-ready selection keys."""
import json
import os
import pathlib
import subprocess
import sys

home = pathlib.Path.home()
cli = home / ".local" / "bin" / "reminderctl"
config = pathlib.Path(os.environ.get("XDG_CONFIG_HOME", home / ".config")) / "calendar-reminder-overlay" / "config.toml"

if not cli.is_file() or not os.access(cli, os.X_OK):
    raise SystemExit(f"reminderctl not found at {cli}; run install.sh first.")

try:
    result = subprocess.run(
        [str(cli), "--config", str(config), "calendars", "--json"],
        check=False,
        capture_output=True,
        text=True,
    )
except OSError as exc:
    raise SystemExit(f"Could not run read-only EDS calendar discovery: {exc}") from exc

try:
    payload = json.loads(result.stdout)
except json.JSONDecodeError:
    detail = result.stderr.strip() or result.stdout.strip() or f"exit status {result.returncode}"
    raise SystemExit(f"EDS calendar discovery failed: {detail}\nNext: check the installed helper and EDS Python bindings, then rerun this read-only command.")

error = payload.get("error")
calendars = payload.get("calendars")
if error or not isinstance(calendars, list):
    detail = error or "unexpected response"
    print(f"EDS calendar discovery failed: {detail}", file=sys.stderr)
    print("Next: check that the Evolution Data Server Python bindings and the desktop calendar service are available, then rerun this read-only command.", file=sys.stderr)
    raise SystemExit(1)

print("Calendar keys (copy the exact key for each calendar you want):")
for item in calendars:
    key = f"{item['source_id']}/{item['calendar_id']}"
    account = item.get("account") or item.get("provider") or "EDS"
    selected = "selected" if item.get("selected") else "not selected"
    print(f"  {item['name']} — {account} [{selected}]\n    {key}")

print("\nTOML selection template (uncomment only the calendars you want):")
print("[calendar]\neds_enabled = true\n\n[selection]\nmode = \"include\"\ncalendars = [")
for item in calendars:
    key = f"{item['source_id']}/{item['calendar_id']}"
    label = item["name"].replace("\n", " ")
    print(f"  # {json.dumps(key)}, # {label}")
print("]")

if result.returncode != 0:
    raise SystemExit(result.returncode)
if not calendars:
    print("\nNo EDS calendars were discovered. Check that the desired calendar is already configured in your desktop account manager, then run this command again. This command does not create or change accounts.")
else:
    print(f"\nEdit {config} and uncomment the keys you want. This command did not change the config or enroll calendars.")
