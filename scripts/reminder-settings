#!/usr/bin/python3
"""Open reminder configuration with the desktop's default text editor."""
import os
import pathlib
import sys

from gi.repository import Gio, GLib

config = pathlib.Path(os.environ.get("XDG_CONFIG_HOME", pathlib.Path.home() / ".config")) / "calendar-reminder-overlay" / "config.toml"
if not config.is_file():
    sys.exit(f"Settings file is missing: {config}. Run ./install.sh first.")
editor = Gio.AppInfo.get_default_for_type("text/plain", False)
if editor is None:
    sys.exit("No default text editor is configured. Choose a default app for plain text files in your desktop settings, then try again.")
try:
    if not editor.launch([Gio.File.new_for_path(str(config))], None):
        sys.exit("The default editor could not open settings. Check your desktop's default text editor and try again.")
except GLib.Error as exc:
    sys.exit(f"Could not open settings in the default editor: {exc.message}")
